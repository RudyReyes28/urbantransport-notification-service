# Perfil y puerto
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8089

# Base de datos (URL JDBC completa)
DB_URL=jdbc:postgresql://<host>:5432/notification_db
DB_USER=
DB_PASSWORD=

# Kafka (IP privada de la EC2 de Kafka)
KAFKA_BOOTSTRAP_SERVERS=172.31.39.189:9092

# Identity (IP privada de su EC2; sin puerto si sigue detrás de nginx)
IDENTITY_JWKS_URI=http://<IP_PRIVADA_IDENTITY>/.well-known/jwks.json

# Correo: empieza en false y cámbialo a true
MAIL_ENABLED=false
MAIL_USERNAME=
# Contraseña de aplicación de Gmail, escrita SIN espacios
MAIL_PASSWORD=
# Opcional: destinatario de la prueba de humo
MAIL_SMOKE_TEST_TO=

# Pool de conexiones a la base de datos
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2